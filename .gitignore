# Dependencies
node_modules/
**/node_modules/
.pnp/
.pnp.js

# Build output
dist/
build/
**/dist/
**/build/
*.tsbuildinfo

# Environment / secrets — NEVER commit
.env
.env.*
!.env.example
backend/.env
frontend/.env

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
output_log.txt

# Editor / OS
.vscode/
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Testing / coverage
coverage/
.nyc_output/

# Cache
.cache/
.parcel-cache/
.eslintcache
.vite/

# Python cache (skills agent)
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd

# Cursor local
.cursor/index/
.codesign/

# Local dev scripts (generated convenience scripts)
# dev.ps1 / dev.bat hoặc các file tương tự — KHÔNG ignore (track luôn)
# vì mỗi dev cần script chung. Nếu muốn ignore thì add vào section LOCAL bên dưới.
