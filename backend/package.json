{
  "name": "securepharma-backend",
  "version": "1.0.0",
  "description": "SecurePharma - Quan ly cua hang duoc pham",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:setup": "node src/scripts/migrate.js setup",
    "db:tables": "node src/scripts/migrate.js tables",
    "db:seed": "node src/scripts/migrate.js seed",
    "db:accounts": "node src/scripts/migrate.js accounts",
    "db:status": "node src/scripts/migrate.js status",
    "db:reset": "node src/scripts/migrate.js reset",
    "db:generate": "node src/scripts/generate_tables_sql.js --output database/XX_generated_snapshot.sql"
  },
  "keywords": [
    "pharmacy",
