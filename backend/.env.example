# ============================================================
# SECUREPHARMA - Environment Variables TEMPLATE
# ============================================================
# File này là MẪU để commit lên git. KHÔNG chứa secret thật.
# Trên máy mới: copy file này thành `.env` rồi điền giá trị thật.
#   cp backend/.env.example backend/.env
# `.env` đã nằm trong .gitignore, sẽ KHÔNG bị commit.
# ============================================================


# ============================================================
# SERVER
# ============================================================
PORT=8080
NODE_ENV=development


# ============================================================
# DATABASE — SQL Server
# ============================================================
DB_SERVER=localhost
DB_NAME=SecurePharmaDB
DB_PORT=1433
DB_ENCRYPT=true

# Chọn 1 trong 2 chế độ auth:
#   true  = Windows Authentication (Integrated Security)
#   false = SQL Server Authentication (cần DB_USER + DB_PASSWORD)
DB_TRUSTED_CONNECTION=false

# Chỉ dùng khi DB_TRUSTED_CONNECTION=false
DB_USER=sa
DB_PASSWORD=YOUR_SQL_PASSWORD_HERE


# ============================================================
# JWT — ⚠️ DEV ONLY. PHẢI ĐỔI KHI LÊN PRODUCTION
# ============================================================
# Format gợi ý: SecurePharma-{env}-v{ver}-{nonce>=16 hex chars}
# Generate nonce: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
#
# QUAN TRỌNG: 2 secret PHẢI KHÁC NHAU (đã enforce trong code).
JWT_SECRET=YOUR_ACCESS_TOKEN_SECRET_HERE
JWT_REFRESH_SECRET=YOUR_REFRESH_TOKEN_SECRET_HERE_DIFFERENT

JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d


# ============================================================
# AES-256-CBC — Mã hóa SĐT, mã số thuế
# ⚠️ DEV ONLY — Production phải lấy từ HSM / Vault
# ============================================================
# Key phải ĐỦ 32 bytes (chuỗi text, tự pad nếu ngắn hơn).
# IV  phải ĐỦ 16 bytes (chuỗi text, tự pad nếu ngắn hơn).
# Nếu đổi key sau khi đã có data → phải re-seed DB (npm run db:seed)
# ============================================================
AES_KEY=YOUR_AES_KEY_PLACEHOLDER_32B
AES_IV=YOUR_AES_IV_PLACEHOLDER_16


# ============================================================
# CHECKLIST SAU KHI ĐIỀN .env
# ============================================================
# [ ] DB_SERVER trỏ đúng instance SQL Server của máy này
# [ ] DB_PASSWORD đúng với user đã khai báo (DB_USER)
# [ ] JWT_SECRET và JWT_REFRESH_SECRET đã khác nhau, không trùng giá trị ở trên
# [ ] Nếu đổi AES_KEY so với máy cũ → chạy lại `npm run db:seed`
# [ ] File này KHÔNG bị commit (đã nằm trong .gitignore)